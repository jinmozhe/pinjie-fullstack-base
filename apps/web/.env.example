# =============================================
# Web 前端环境变量（Next.js）
# 复制为 .env.local 并填入真实值
# NEXT_PUBLIC_ 前缀的变量会暴露给浏览器端
# =============================================

# 后端 API 地址（服务端调用，不暴露给浏览器）
BACKEND_URL=http://localhost:8000

# 后端 API 地址（客户端调用，暴露给浏览器）
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
