# =============================================
# 后端运行环境变量
# 复制为 .env 并填入真实值，.env 不得入库
# =============================================

PROJECT_NAME="Pinjie Fullstack Base Backend"
ENVIRONMENT=local
DEBUG=true

API_V1_STR=/api/v1

# 数据库（连接本地 PostgreSQL）
DATABASE_URL=postgresql+asyncpg://pinjie_fullstack:your_password@localhost:5432/pinjie_fullstack_dev
# 测试命令必须显式使用独立的 _test 数据库
TEST_DATABASE_URL=postgresql+asyncpg://pinjie_fullstack_test:your_password@localhost:5432/pinjie_fullstack_test

# Redis 默认关闭；验证 required 模式时改为 required 并提供地址
REDIS_MODE=disabled
REDIS_URL=redis://localhost:6379/0

# 安全边界
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
FORCE_HTTPS=false
API_DOCS_ENABLED=true
RELEASE_VERSION=local
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DEPENDENCY_TIMEOUT=2
