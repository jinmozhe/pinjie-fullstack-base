# =============================================
# 后端运行环境变量
# 复制为 .env 并填入真实值，.env 不得入库
# =============================================

PROJECT_NAME="Pinjie Fullstack Backend"
ENVIRONMENT=development
DEBUG=true

# JWT 安全
SECRET_KEY=your-secret-key-min-32-chars
API_V1_STR=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库（连接本地 PostgreSQL）
DATABASE_URL=postgresql+asyncpg://pinjie_fullstack:your_password@localhost:5432/pinjie_fullstack_dev

# Redis（Docker 容器）
REDIS_URL=redis://localhost:6379/0

# 跨域（允许的前端地址）
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
